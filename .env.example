# ===========================================================================
# LifePilot settings — copy this file to `.env` and edit that copy.
#
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
#
# `.env` is already ignored by git, so a key placed here is never committed.
# NEVER paste a key into a terminal command; it lands in your shell history.
# ===========================================================================

# --- Optional: the language model that reads sentences ----------------------
# Leave all of these blank to use the built-in keyword rules (works offline).
# Set PROVIDER + KEY and LifePilot starts inferring times and context.
#
# Free options, no credit card:
#   groq        -> console.groq.com/keys            (recommended)
#   gemini      -> aistudio.google.com/apikey
#   openrouter  -> openrouter.ai/keys
#   ollama      -> no key at all, runs on your own machine
#
# ONE key is enough for all three agents. They are behaviours, not services.
LIFEPILOT_LLM_PROVIDER=
LIFEPILOT_LLM_API_KEY=
# LEAVE BLANK unless you want a different model than the provider default.
# Groq defaults to llama-3.3-70b-versatile, Gemini to gemini-2.5-flash.
LIFEPILOT_LLM_MODEL=
# LEAVE BLANK unless you run a custom or local endpoint (e.g. Ollama).
LIFEPILOT_LLM_BASE_URL=

# --- Where reminders go ------------------------------------------------------
# With nothing set, every reminder is written to backend/data/outbox.log and
# printed by `python -m backend.main --watch`.
#
# Discord: Server Settings -> Integrations -> Webhooks -> Copy Webhook URL.
# A webhook URL is a secret: anyone holding it can post into your channel.
# LEAVE BLANK to keep reminders in backend/data/outbox.log (no account needed).
LIFEPILOT_DISCORD_WEBHOOK=
LIFEPILOT_SLACK_WEBHOOK=
LIFEPILOT_SWITCH_WEBHOOK=

# --- How the scheduler behaves ----------------------------------------------
# All three already hold their defaults. Change only if you want different
# behaviour; deleting the value also restores the default.
# Seconds between clock checks (default 60).
LIFEPILOT_TICK_INTERVAL=60
# Days ahead to warn about a task (1 = today and tomorrow).
LIFEPILOT_TASK_WINDOW=1
# Days before a bill's due date to start reminding.
LIFEPILOT_BILL_WINDOW=3
# Set to 0 to switch the automatic clock off entirely.
LIFEPILOT_TICK=1

# --- Storage -----------------------------------------------------------------
# LEAVE BLANK to use backend/data/lifepilot.db inside the project folder.
LIFEPILOT_DB=
# Your timezone. This sets the default for the briefing/reminder times, so set
# it to where you actually live. Find yours by running, in Python:
#     import zoneinfo; print(zoneinfo.available_timezones())
LIFEPILOT_TIMEZONE=Asia/Kathmandu

# --- Photo OCR (optional) ----------------------------------------------------
# LEAVE BLANK. Only fill this in if Tesseract is installed in an unusual place
# and the app cannot find it on its own.
TESSERACT_CMD=
